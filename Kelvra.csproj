<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>Kelvra</AssemblyName>
    <Product>Kelvra</Product>
    <Version>1.4.0</Version>
    <Description>Hardware monitor, in-game overlays and PC toolkit for Windows.</Description>
    <Copyright>Copyright © 2026 Kelvra contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its types out of the global namespace -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- The test project lives in tests/ (run: dotnet test tests/Kelvra.Tests); keep its files out of the app -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Page Remove="tests/**" />
    <InternalsVisibleTo Include="Kelvra.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!--
    PawnIO driver installer (https://pawnio.eu). Needed for CPU temperatures/voltages.
    Downloaded from the official release at build time (not committed to git), hash-checked,
    and embedded so Kelvra can offer to install it on first run.
  -->
  <PropertyGroup>
    <PawnIOVersion>2.2.0</PawnIOVersion>
    <PawnIOSha256>1F519A22E47187F70A1379A48CA604981C4FCF694F4E65B734AAA74A9FBA3032</PawnIOSha256>
    <PawnIODir>$(MSBuildProjectDirectory)\Assets\PawnIO\$(PawnIOVersion)</PawnIODir>
    <PawnIOSetup>$(PawnIODir)\PawnIO_setup.exe</PawnIOSetup>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PawnIOSetup)" LogicalName="PawnIO_setup.exe" />
    <!-- Checked again at runtime, right before the extracted installer is started -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PawnIOSha256</_Parameter1>
      <_Parameter2>$(PawnIOSha256)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="DownloadPawnIO" BeforeTargets="PrepareForBuild">
    <DownloadFile Condition="!Exists('$(PawnIOSetup)')"
                  SourceUrl="https://github.com/namazso/PawnIO.Setup/releases/download/$(PawnIOVersion)/PawnIO_setup.exe"
                  DestinationFolder="$(PawnIODir)" />
    <VerifyFileHash File="$(PawnIOSetup)" Hash="$(PawnIOSha256)" Algorithm="SHA256" />
  </Target>

  <!--
    Intel PresentMon console (https://github.com/GameTechDev/PresentMon, MIT). Measures FPS and frame times in games.
    Same handling as PawnIO: downloaded from the official release at build time, hash-checked, embedded.
  -->
  <PropertyGroup>
    <PresentMonVersion>2.6.0</PresentMonVersion>
    <PresentMonSha256>B2A706BC6AD475749E3B7E3409263AA1E6906D45BDCF993F6DBC0F660188F1AF</PresentMonSha256>
    <PresentMonDir>$(MSBuildProjectDirectory)\Assets\PresentMon\$(PresentMonVersion)</PresentMonDir>
    <PresentMonExe>$(PresentMonDir)\PresentMon-$(PresentMonVersion)-x64.exe</PresentMonExe>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PresentMonExe)" LogicalName="PresentMon.exe" />
    <!-- Checked again at runtime, right before the extracted exe is started -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PresentMonSha256</_Parameter1>
      <_Parameter2>$(PresentMonSha256)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="DownloadPresentMon" BeforeTargets="PrepareForBuild">
    <DownloadFile Condition="!Exists('$(PresentMonExe)')"
                  SourceUrl="https://github.com/GameTechDev/PresentMon/releases/download/v$(PresentMonVersion)/PresentMon-$(PresentMonVersion)-x64.exe"
                  DestinationFolder="$(PresentMonDir)" />
    <VerifyFileHash File="$(PresentMonExe)" Hash="$(PresentMonSha256)" Algorithm="SHA256" />
  </Target>

</Project>
