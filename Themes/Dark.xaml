<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kelvra 2 · "Colour means heat" (dark): a calm graphite instrument. Neutrals do the work; the only saturated colours
         are the thermal scale (cold, fine, warm, hot, critical) and they always mean a temperature or a state.
         Contrast on the panel (#14171B, measured): Text 15.0:1 · Muted 8.0:1 · Subtle 5.0:1 · Cold 8.2:1 · Fine 10.0:1 ·
         Warm 9.9:1 · Hot 7.0:1 · Critical 5.6:1 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#0D0F12" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0D0F12" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14171B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1B1F25" />
    <SolidColorBrush x:Key="InputBrush" Color="#0D0F12" />
    <SolidColorBrush x:Key="LineBrush" Color="#242930" />
    <!-- Stronger lines: buttons, inputs, chips -->
    <SolidColorBrush x:Key="Line2Brush" Color="#323943" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A6AEBA" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#7F8895" />
    <!-- Accent: replaced at start by Accents.Apply (default Graphite = white on graphite) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B1F25" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0D0F12" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#323943" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#323943" />
    <SolidColorBrush x:Key="ChartSecondaryBrush" Color="#5B6472" />

    <!-- Thermal scale: < 40 °C cold · 40–69 fine · 70–81 warm · 82–91 hot · ≥ 92 or the limit critical -->
    <SolidColorBrush x:Key="ColdBrush" Color="#6CB4FF" />
    <SolidColorBrush x:Key="GoodBrush" Color="#4CD99A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F3B646" />
    <SolidColorBrush x:Key="HotBrush" Color="#FF7B47" />
    <SolidColorBrush x:Key="CritBrush" Color="#FF4E6B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF4E6B" />
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#244CD99A" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#24F3B646" />
    <SolidColorBrush x:Key="HotSoftBrush" Color="#24FF7B47" />
    <SolidColorBrush x:Key="CritSoftBrush" Color="#24FF4E6B" />
</ResourceDictionary>
