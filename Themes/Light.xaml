<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kelvra 2 · "Colour means heat" (light): the same instrument on paper. The thermal colours are darker here so small
         text stays readable. Contrast on white (measured): Text 17.8:1 · Muted 7.5:1 · Subtle 5.0:1 (4.6:1 on the window) ·
         Cold 5.3:1 · Fine 5.0:1 · Warm 5.7:1 · Hot 5.3:1 · Critical 5.1:1 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#E3E6EA" />
    <SolidColorBrush x:Key="Line2Brush" Color="#D2D7DE" />
    <SolidColorBrush x:Key="TextBrush" Color="#15181C" />
    <SolidColorBrush x:Key="MutedBrush" Color="#4D5562" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#66707E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#15181C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#15181C" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C5CAD3" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#D2D7DE" />
    <SolidColorBrush x:Key="ChartSecondaryBrush" Color="#9AA2AE" />

    <SolidColorBrush x:Key="ColdBrush" Color="#1A6BC7" />
    <SolidColorBrush x:Key="GoodBrush" Color="#0B7F50" />
    <SolidColorBrush x:Key="WarnBrush" Color="#8F5C00" />
    <SolidColorBrush x:Key="HotBrush" Color="#BD420E" />
    <SolidColorBrush x:Key="CritBrush" Color="#D42445" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D42445" />
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#1F0B7F50" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#1F8F5C00" />
    <SolidColorBrush x:Key="HotSoftBrush" Color="#1FBD420E" />
    <SolidColorBrush x:Key="CritSoftBrush" Color="#1FD42445" />
</ResourceDictionary>
