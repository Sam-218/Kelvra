<UserControl x:Class="Kelvra.AlertsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <UserControl.Resources>
        <local:MatchConverter x:Key="Match" />
        <Style x:Key="SmallBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="70" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Inline" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,24,28,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Alerts" Style="{StaticResource H1}" />
                <TextBlock Text="Get a Windows notification when a sensor goes above or below a limit."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="SoundSwitch" Style="{StaticResource Switch}" Content="Sound" Margin="0,0,16,0"
                          Checked="Sound_Changed" Unchecked="Sound_Changed" />
                <Button Style="{StaticResource AccentButton}" Click="NewAlert_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="New alert" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- rules -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="EmptyState" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="No alerts yet" Style="{StaticResource H2}" />
                            <TextBlock Text="Click “New alert” to pick any sensor, or start with one of these:" Style="{StaticResource Muted}" />
                            <WrapPanel x:Name="Presets" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="RuleList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AlertRule}">
                                <Border x:Name="Card" Style="{StaticResource Card}" Padding="16,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource GoodBrush}" Margin="0,0,12,0"
                                                     VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding SensorName}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding HardwareName}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="0"
                                                      ToolTip="Turn this alert on or off" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="8,0,0,0"
                                                    Click="Delete_Click" ToolTip="Delete alert" AutomationProperties.Name="Delete alert" />
                                        </Grid>

                                        <WrapPanel Margin="22,12,0,0">
                                            <TextBlock Text="Alert when it's" Style="{StaticResource Inline}" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource SegmentHost}" Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource Segment}" Content="above" Padding="8,2"
                                                                 GroupName="{Binding Id}"
                                                                 IsChecked="{Binding Condition, Converter={StaticResource Match}, ConverterParameter=Above}" />
                                                    <RadioButton Style="{StaticResource Segment}" Content="below" Padding="8,2"
                                                                 GroupName="{Binding Id}"
                                                                 IsChecked="{Binding Condition, Converter={StaticResource Match}, ConverterParameter=Below}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBox Style="{StaticResource SmallBox}" Text="{Binding ThresholdDisplay, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="{Binding UnitText}" Style="{StaticResource Inline}" Margin="0,0,10,0" />
                                            <TextBlock Text="for" Style="{StaticResource Inline}" />
                                            <TextBox Style="{StaticResource SmallBox}" Width="54" Text="{Binding DurationSeconds, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="seconds, remind again after" Style="{StaticResource Inline}" />
                                            <TextBox Style="{StaticResource SmallBox}" Width="54" Text="{Binding CooldownMinutes, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="min" Style="{StaticResource Inline}" />
                                        </WrapPanel>

                                        <Grid Margin="22,10,0,0">
                                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                                                <Run Text="Now" /> <Run Text="{Binding CurrentText, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="  ·  " /> <Run Text="{Binding LastFiredText, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" HorizontalAlignment="Right"
                                                    Content="Send test notification" Click="Test_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource HotBrush}" />
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource HotBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource MutedBrush}" />
                                        <Setter TargetName="Card" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- recent -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Recent alerts" Style="{StaticResource H2}" />
                    <TextBlock x:Name="NoRecent" DockPanel.Dock="Top" Text="Nothing yet – that's a good thing." Style="{StaticResource Muted}" />
                    <ListBox x:Name="RecentList" ItemContainerStyle="{StaticResource PlainRow}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AlertEvent}">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
