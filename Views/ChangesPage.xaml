<UserControl x:Class="Kelvra.ChangesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Changes" Style="{StaticResource H1}" />
                <TextBlock Text="Drivers, Windows updates, apps and startup items, day by day, and how your games ran after a driver change."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ShowAll" Style="{StaticResource Segment}" Content="All" GroupName="ChangeFilter" IsChecked="True" Checked="Filter_Checked" />
                        <RadioButton x:Name="ShowSystem" Style="{StaticResource Segment}" Content="Drivers and Windows" GroupName="ChangeFilter" Checked="Filter_Checked" />
                        <RadioButton x:Name="ShowApps" Style="{StaticResource Segment}" Content="Apps" GroupName="ChangeFilter" Checked="Filter_Checked" />
                        <RadioButton x:Name="ShowStartup" Style="{StaticResource Segment}" Content="Startup" GroupName="ChangeFilter" Checked="Filter_Checked" />
                    </StackPanel>
                </Border>
                <Button Margin="10,0,0,0" Click="Refresh_Click" ToolTip="Look for changes now">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Check now" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ChangeRow}">
                            <Grid>
                                <TextBlock x:Name="Header" Text="{Binding Text}" Style="{StaticResource Overline}" Margin="0,14,0,6" Visibility="Collapsed" />
                                <Border x:Name="Row" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                                       Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Muted}" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter TargetName="Header" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
