<UserControl x:Class="Kelvra.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <Border Style="{StaticResource Card}" Margin="0" Padding="8">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="12,8,12,12">
                <StackPanel>
                    <TextBlock Text="Cleanup" Style="{StaticResource H2}" Margin="0" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Known places that fill up with files you don't need. Files in use are always skipped." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="Rescan_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Rescan" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CleanButton" Style="{StaticResource AccentButton}" Click="Clean_Click" MinWidth="170" Content="Clean selected" />
                </StackPanel>
            </Grid>
            <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource LineBrush}" Margin="6,0" />

            <Border x:Name="ResultBar" DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8"
                    Padding="12,8" Margin="6,8,6,2" Visibility="Collapsed">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
            </Border>

            <ListView x:Name="TargetList" ItemContainerStyle="{StaticResource PlainRow}">
                <ListView.Resources>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource PlainRow}">
                        <Setter Property="Padding" Value="12,10" />
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CleanupTarget}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Click="Check_Click"
                                      AutomationProperties.Name="{Binding Name}" />
                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Margin="12,0,12,0"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SizeText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <Button Grid.Column="4" Style="{StaticResource IconButton}" AutomationProperties.Name="Open folder" Content="&#xE838;" Margin="10,0,0,0"
                                    Click="OpenFolder_Click" ToolTip="Open folder" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
