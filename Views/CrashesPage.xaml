<UserControl x:Class="Kelvra.CrashesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Crashes" Style="{StaticResource H1}" />
                <TextBlock Text="App crashes and freezes, graphics driver resets, blue screens and sudden shutdowns from Windows' logs, in plain words."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ShowAll" Style="{StaticResource Segment}" Content="All" GroupName="CrashFilter" IsChecked="True" Checked="Filter_Checked" />
                        <RadioButton x:Name="ShowSystem" Style="{StaticResource Segment}" Content="PC and driver" GroupName="CrashFilter" Checked="Filter_Checked"
                                     ToolTip="Blue screens, sudden shutdowns and graphics driver resets" />
                        <RadioButton x:Name="ShowApps" Style="{StaticResource Segment}" Content="Apps" GroupName="CrashFilter" Checked="Filter_Checked" />
                    </StackPanel>
                </Border>
                <Button Margin="10,0,0,0" Click="Refresh_Click" ToolTip="Read Windows' logs again now">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Check now" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="PatternBar" DockPanel.Dock="Top" Background="{DynamicResource WarnSoftBrush}" CornerRadius="6" Padding="14,10"
                Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="PatternText" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CrashView}">
                            <Border Style="{StaticResource Card}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource WarnSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center"
                                                   Foreground="{Binding Brush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,130,0" />
                                            <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="{Binding Culprit}" FontSize="12" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="What to try: " FontWeight="SemiBold" /><Run Text="{Binding Advice, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Context}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                                   Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
