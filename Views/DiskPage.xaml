<UserControl x:Class="Kelvra.DiskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <DockPanel Margin="28,24,28,20">

        <!-- header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Disk usage" Style="{StaticResource H1}" />
                <TextBlock x:Name="Subtitle" Text="See what's taking up space. Pick a drive or folder and press Scan."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AnalyzerTab" Style="{StaticResource Segment}" Content="Analyzer" GroupName="DiskTab"
                                     IsChecked="True" Checked="DiskTab_Checked" />
                        <RadioButton x:Name="CleanupTab" Style="{StaticResource Segment}" Content="Cleanup" GroupName="DiskTab"
                                     Checked="DiskTab_Checked" />
                        <RadioButton x:Name="DuplicatesTab" Style="{StaticResource Segment}" Content="Duplicates" GroupName="DiskTab"
                                     Checked="DiskTab_Checked" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="AnalyzerActions" Orientation="Horizontal">
                <Button Click="Folder_Click" AutomationProperties.Name="Scan a folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Folder…" />
                    </StackPanel>
                </Button>
                <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="110"
                        Click="Scan_Click" Content="Scan" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <WrapPanel x:Name="DriveChips" DockPanel.Dock="Top" Margin="0,0,0,10" />

        <Grid>
        <Grid x:Name="AnalyzerContent">
            <!-- results -->
            <Grid x:Name="Results" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="0.85*" MinHeight="120" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <!-- folder tree -->
                    <Border Style="{StaticResource Card}" Padding="6" Margin="0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,6,24,6" TextElement.Foreground="{DynamicResource MutedBrush}"
                                  TextElement.FontSize="11" TextElement.FontWeight="SemiBold">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NAME" />
                                <TextBlock Grid.Column="1" Text="% OF PARENT" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="2" Text="SIZE" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="FILES" HorizontalAlignment="Right" />
                            </Grid>
                            <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource LineBrush}" Margin="6,0" />
                            <ListView x:Name="TreeList" ItemContainerStyle="{StaticResource PlainRow}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      SelectionMode="Single" SelectionChanged="TreeList_SelectionChanged"
                                      MouseDoubleClick="TreeList_DoubleClick" PreviewMouseRightButtonUp="TreeList_RightClick"
                                      KeyDown="TreeList_KeyDown">
                                <ListView.Resources>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource PlainRow}">
                                        <Setter Property="Focusable" Value="True" />
                                        <Setter Property="Padding" Value="8,3" />
                                    </Style>
                                </ListView.Resources>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DiskRow}">
                                        <Grid x:Name="RowRoot">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <DockPanel Margin="{Binding Indent}" LastChildFill="True">
                                                <Button x:Name="Chevron" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="9"
                                                        Content="&#xE76C;" Click="Chevron_Click" RenderTransformOrigin="0.5,0.5"
                                                        Visibility="Hidden" AutomationProperties.Name="Expand">
                                                    <Button.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Button.RenderTransform>
                                                </Button>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{Binding IconBrush}"
                                                           Margin="4,0,8,0" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" Margin="0,0,8,0" />
                                            </DockPanel>
                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Border Width="60" Height="8" CornerRadius="4" HorizontalAlignment="Left"
                                                        Background="{DynamicResource SwitchOffBrush}" />
                                                <Border Width="{Binding BarWidth}" Height="8" CornerRadius="4" HorizontalAlignment="Left"
                                                        Background="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding PercentText}" Style="{StaticResource Muted}" Margin="66,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding FilesText}" Foreground="{DynamicResource MutedBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding CanExpand}" Value="True">
                                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMore}" Value="True">
                                                <Setter TargetName="RowRoot" Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <!-- file types / largest files -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10" Margin="0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="4,2,4,10">
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TypesTab" Style="{StaticResource Segment}" Content="File types" GroupName="Side"
                                                     IsChecked="True" Checked="SideTab_Checked" />
                                        <RadioButton x:Name="LargestTab" Style="{StaticResource Segment}" Content="Largest files" GroupName="Side"
                                                     Checked="SideTab_Checked" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="ClearHighlightButton" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="12"
                                        HorizontalAlignment="Right" Content="Clear highlight" Visibility="Collapsed"
                                        Click="ClearHighlight_Click" />
                            </Grid>

                            <ListView x:Name="TypesList" ItemContainerStyle="{StaticResource PlainRow}"
                                      SelectionChanged="TypesList_SelectionChanged"
                                      ToolTip="Click a file type to highlight it in the map">
                                <ListView.Resources>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource PlainRow}">
                                        <Setter Property="Focusable" Value="True" />
                                    </Style>
                                </ListView.Resources>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:FileTypeRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="54" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource Muted}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <ListView x:Name="LargestList" ItemContainerStyle="{StaticResource PlainRow}" Visibility="Collapsed"
                                      SelectionChanged="LargestList_SelectionChanged" PreviewMouseRightButtonUp="LargestList_RightClick">
                                <ListView.Resources>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource PlainRow}">
                                        <Setter Property="Focusable" Value="True" />
                                    </Style>
                                </ListView.Resources>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:LargeFileRow}">
                                        <Grid ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="76" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="10" Background="Transparent"
                              ResizeDirection="Rows" Cursor="SizeNS" ToolTip="Drag to resize" />

                <!-- treemap -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0">
                    <DockPanel>
                        <!-- breadcrumb: where the map is zoomed to -->
                        <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ZoomOutButton" Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,6,0"
                                    Click="ZoomOut_Click" IsEnabled="False" ToolTip="Zoom out one level"
                                    AutomationProperties.Name="Zoom out">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="Up" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <WrapPanel x:Name="Breadcrumb" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <Grid DockPanel.Dock="Bottom" Margin="4,8,4,0">
                            <TextBlock x:Name="HoverText" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Text="Hover to see what's what · click to find it in the tree · double-click a folder to zoom in · right-click for actions" />
                        </Grid>
                        <WrapPanel x:Name="Legend" DockPanel.Dock="Bottom" Margin="4,8,4,0" />
                        <Border CornerRadius="6" ClipToBounds="True">
                            <local:TreemapControl x:Name="Treemap" />
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- empty state -->
            <Border x:Name="EmptyState" Style="{StaticResource Card}" Margin="0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="44" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="Pick a drive above (or a folder) and press Scan." Style="{StaticResource Muted}" FontSize="14"
                               Margin="0,14,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Everything is read locally – nothing is changed unless you choose to delete something."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- scanning -->
            <Border x:Name="ScanningPanel" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                    <TextBlock x:Name="ScanTitle" Text="Scanning…" Style="{StaticResource H2}" FontSize="18" />
                    <Grid x:Name="ProgressTrack" Height="8" Margin="0,4,0,0">
                        <Border CornerRadius="4" Background="{DynamicResource SwitchOffBrush}" />
                        <Border x:Name="ProgressFill" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <TextBlock x:Name="ScanStats" Margin="0,12,0,0" FontSize="13" />
                    <TextBlock x:Name="ScanCurrent" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <Button Content="Cancel" HorizontalAlignment="Left" Margin="0,16,0,0" MinWidth="90" Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </Grid>
            <local:CleanupView x:Name="CleanupView" Visibility="Collapsed" />
            <local:DuplicatesView x:Name="DuplicatesView" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
