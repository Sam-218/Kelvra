<UserControl x:Class="Kelvra.FansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <UserControl.Resources>
        <local:MatchConverter x:Key="Match" />
        <local:MatchVisibilityConverter x:Key="MatchVis" />
        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Fans" Style="{StaticResource H1}" />
            <TextBlock Text="Let a temperature set your fan speeds, or fix a speed. Fans you leave on Automatic stay under BIOS control."
                       Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <Border x:Name="Banner" DockPanel.Dock="Top" Background="{DynamicResource WarnSoftBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" MaxWidth="900" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- fan outputs -->
            <Border Style="{StaticResource Card}" Padding="8" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FAN OUTPUTS" Style="{StaticResource Overline}" Margin="8,6,8,8" />
                    <Grid>
                        <ListBox x:Name="FanList" SelectionChanged="FanList_SelectionChanged" AutomationProperties.Name="Fan outputs">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:FanRow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Device}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource Overline}" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding LiveText}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoFansText" Style="{StaticResource Muted}" Margin="8" Visibility="Collapsed"
                                   Text="No fan outputs found that Kelvra can control." />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- editor -->
            <ScrollViewer x:Name="Editor" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="FanTitle" Style="{StaticResource H2}" Margin="0" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="SPEED" Style="{StaticResource Overline}" FontSize="10" />
                                        <TextBlock x:Name="RpmText" Style="{StaticResource Mono}" FontSize="20" Text="–" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="OUTPUT" Style="{StaticResource Overline}" FontSize="10" />
                                        <TextBlock x:Name="OutputText" Style="{StaticResource Mono}" FontSize="20" Text="–" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SegmentHost}" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal" AutomationProperties.Name="Fan mode">
                                    <RadioButton Style="{StaticResource Segment}" Content="Automatic (BIOS)" GroupName="FanMode"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Match}, ConverterParameter=Auto}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Fixed speed" GroupName="FanMode"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Match}, ConverterParameter=Fixed}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Curve" GroupName="FanMode"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Match}, ConverterParameter=Curve}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- fixed -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding Mode, Converter={StaticResource MatchVis}, ConverterParameter=Fixed}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Speed" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" VerticalAlignment="Center" Value="{Binding FixedPercent}"
                                    AutomationProperties.Name="Fixed fan speed" />
                            <TextBlock Grid.Column="2" Text="{Binding FixedPercent, StringFormat={}{0:0} %}" Style="{StaticResource ValueText}" />
                        </Grid>
                    </Border>

                    <!-- curve -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding Mode, Converter={StaticResource MatchVis}, ConverterParameter=Curve}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Follows" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="SourceBox" Grid.Column="1" SelectedValue="{Binding SourceId}" SelectedValuePath="Tag"
                                          AutomationProperties.Name="Temperature the curve follows" HorizontalAlignment="Left" MinWidth="320" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="CURVE" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Start from:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="Silent" Tag="silent" Click="Preset_Click" Margin="0,0,6,0" Padding="10,4" ToolTip="Quiet until it gets warm" />
                                    <Button Content="Balanced" Tag="balanced" Click="Preset_Click" Margin="0,0,6,0" Padding="10,4" />
                                    <Button Content="Performance" Tag="performance" Click="Preset_Click" Padding="10,4" ToolTip="Cooler, louder" />
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <local:CurveEditor x:Name="Curve" Height="260" Profile="{Binding}" AutomationProperties.Name="Fan curve" />
                            </Border>
                            <TextBlock Text="POINTS (°C → %)" Style="{StaticResource Overline}" Margin="0,12,0,6" />
                            <ItemsControl x:Name="PointList" ItemsSource="{Binding Points}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:FanPoint}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                            <TextBox Width="48" Text="{Binding Temp, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" AutomationProperties.Name="Temperature °C"
                                                     LostFocus="Point_LostFocus" />
                                            <TextBlock Text="° →" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBox Width="48" Text="{Binding Percent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" AutomationProperties.Name="Fan speed %"
                                                     LostFocus="Point_LostFocus" />
                                            <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- safety -->
                    <Border x:Name="SafetyCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Safety" Style="{StaticResource H2}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Never slower than" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Also protects you if Kelvra is force-closed" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" VerticalAlignment="Center" Value="{Binding MinPercent}"
                                        AutomationProperties.Name="Minimum fan speed" />
                                <TextBlock Grid.Column="2" Text="{Binding MinPercent, StringFormat={}{0:0} %}" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Full speed from" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Temperature of the chosen sensor" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <Slider Grid.Column="1" Minimum="50" Maximum="120" TickFrequency="1" VerticalAlignment="Center" Value="{Binding CriticalTemp}"
                                        AutomationProperties.Name="Full speed from temperature" />
                                <TextBlock Grid.Column="2" Text="{Binding CriticalTemp, StringFormat={}{0:0} °C}" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Grid Margin="0,0,0,10" Visibility="{Binding Mode, Converter={StaticResource MatchVis}, ConverterParameter=Curve}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Slow down after a drop of" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Stops the fan pulsing up and down" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <Slider Grid.Column="1" Minimum="0" Maximum="15" TickFrequency="1" VerticalAlignment="Center" Value="{Binding Hysteresis}"
                                        AutomationProperties.Name="Hysteresis" />
                                <TextBlock Grid.Column="2" Text="{Binding Hysteresis, StringFormat={}{0:0} °C}" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Slow down by at most" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Speeding up is always immediate" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <Slider Grid.Column="1" Minimum="1" Maximum="50" TickFrequency="1" VerticalAlignment="Center" Value="{Binding RampDown}"
                                        AutomationProperties.Name="Slow-down rate" />
                                <TextBlock Grid.Column="2" Text="{Binding RampDown, StringFormat={}{0:0} %/s}" Style="{StaticResource ValueText}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="Kelvra hands fans back to the BIOS when it exits, crashes, you sign out, or the temperature sensor disappears. If Kelvra is ended from Task Manager, a fan can keep its last speed until the PC restarts – the minimum above is your safety net then." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
