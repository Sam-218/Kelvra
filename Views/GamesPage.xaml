<UserControl x:Class="Kelvra.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="16" Margin="-6,0,6,0"
                            VerticalAlignment="Center" Click="Back_Click" ToolTip="All games" AutomationProperties.Name="All games" Visibility="Collapsed" />
                    <TextBlock x:Name="Heading" Text="Games" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid>
                    <!-- every game, one card each: click for its sessions -->
                    <ItemsControl x:Name="GameList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:GameGroup}">
                                <Button Style="{StaticResource Tile}" Margin="0,0,0,10" Click="Game_Click"
                                        AutomationProperties.Name="{Binding Name}" ToolTip="Show this game's sessions">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CrashText, StringFormat={} · {0}}" Foreground="{DynamicResource CritBrush}" FontSize="12"
                                                           Visibility="{Binding HasCrashes, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,24,0" VerticalAlignment="Center" MinWidth="64">
                                            <TextBlock Text="{Binding Avg}" Style="{StaticResource Hero}" FontSize="22" HorizontalAlignment="Right" />
                                            <TextBlock Text="avg FPS" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,20,0" VerticalAlignment="Center" MinWidth="56">
                                            <TextBlock Text="{Binding Low}" Style="{StaticResource Hero}" FontSize="22" FontWeight="Normal" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="1 % low" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="44" Margin="0,0,14,0"
                                                    ToolTip="What limited the frame rate most of the time: the graphics card, the processor, or a frame cap / VSync">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasHeldBy}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding HeldBy}" Style="{StaticResource PillText}" HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- one game's sessions -->
                    <ItemsControl x:Name="SessionsList" Focusable="False" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:GameSessionSummary}">
                                <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Top">
                                            <TextBlock x:Name="Glyph" Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                            <TextBlock x:Name="When" Text="{Binding When}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FpsLine}" Margin="0,4,0,0" FontSize="14" />
                                            <TextBlock Text="{Binding DetailLine}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open frames CSV" VerticalAlignment="Center" Click="OpenSessionCsv_Click"
                                                Visibility="{Binding HasCsv, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Every frame of this benchmark run, for Excel or frametime tools" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Benchmark}" Value="True">
                                        <Setter TargetName="Glyph" Property="Text" Value="&#xE916;" />
                                        <Setter TargetName="When" Property="Text" Value="{Binding When, StringFormat={}{0} · Benchmark}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Crashed}" Value="True">
                                        <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource CritBrush}" />
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CritBrush}" />
                                        <Setter TargetName="When" Property="Text" Value="{Binding When, StringFormat={}{0} · crashed}" />
                                        <Setter TargetName="Card" Property="ToolTip" Value="Windows recorded a crash or freeze of this game while it ran (see Crashes)." />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
