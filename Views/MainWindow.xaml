<Window x:Class="Kelvra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kelvra"
        Title="Kelvra" Width="1180" Height="760" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <local:MatchConverter x:Key="Match" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Icon rail ================= -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14,0,10">
                <Image DockPanel.Dock="Top" Source="/Assets/app.ico" Width="26" Height="26" Margin="0,0,0,14"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Kelvra · hardware monitor &amp; overlays" />

                <!-- Bottom: quick overlay controls (tooltips name the shortcuts) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="14,4,14,6" />
                    <Button Style="{StaticResource RailButton}" Content="&#xE73F;" Click="Mini_Click"
                            ToolTip="Mini mode · a small always-on-top window with the essentials" AutomationProperties.Name="Mini mode" />
                    <CheckBox x:Name="OverlaysSwitch" Style="{StaticResource RailButton}" Content="&#xE890;"
                              Checked="OverlaysSwitch_Changed" Unchecked="OverlaysSwitch_Changed" />
                    <Button x:Name="LockAllButton" Style="{StaticResource RailButton}" Content="&#xE785;" Click="LockAll_Click" />
                </StackPanel>

                <!-- Scrolls (wheel/keyboard) when the window is too short for every page button -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                <StackPanel>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Overview"
                                 GroupName="Nav" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSensors" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Sensors"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavCategories" Style="{StaticResource NavButton}" Tag="&#xE71C;" Content="Categories"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="History"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAlerts" Style="{StaticResource NavButton}" Tag="&#xEA8F;" Content="Alerts"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSystem" Style="{StaticResource NavButton}" Tag="&#xE977;" Content="System"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavButton}" Tag="&#xECAA;" Content="Apps"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDisk" Style="{StaticResource NavButton}" Tag="&#xEDA2;" Content="Disk"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavFans" Style="{StaticResource NavButton}" Tag="&#xEC4A;" Content="Fans"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavOverlays" Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="Overlays"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 GroupName="Nav" Checked="Nav_Checked" />
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Pages ================= -->
        <Grid Grid.Column="1">

            <local:OverviewPage x:Name="OverviewPage" />

            <!-- Sensors -->
            <local:SensorsPage x:Name="SensorsPage" Visibility="Collapsed" />

            <!-- Categories -->
            <local:CategoriesPage x:Name="CategoriesPage" Visibility="Collapsed" />

            <local:HistoryPage x:Name="HistoryPage" Visibility="Collapsed" />
            <local:AlertsPage x:Name="AlertsPage" Visibility="Collapsed" />
            <local:SystemPage x:Name="SystemPage" Visibility="Collapsed" />
            <local:AppsPage x:Name="AppsPage" Visibility="Collapsed" />

            <!-- Disk usage -->
            <local:DiskPage x:Name="DiskPage" Visibility="Collapsed" />

            <!-- Overlays -->
            <local:FansPage x:Name="FansPage" Visibility="Collapsed" />
            <local:OverlaysPage x:Name="OverlaysPage" Visibility="Collapsed" />

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,20" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,20" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource H2}" />
                            <Grid>
                                <TextBlock Text="App theme" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" Content="System" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" Content="Dark" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" Content="Light" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Accent colour" Style="{StaticResource FieldLabel}" />
                                <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" HorizontalAlignment="Right"
                                            AutomationProperties.Name="Accent colour" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Temperature unit" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="UnitCelsius" Style="{StaticResource Segment}" Content="°C  Celsius" GroupName="Unit"
                                                     Checked="Unit_Checked" />
                                        <RadioButton x:Name="UnitFahrenheit" Style="{StaticResource Segment}" Content="°F  Fahrenheit" GroupName="Unit"
                                                     Checked="Unit_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Monitoring" Style="{StaticResource H2}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Refresh interval" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="RefreshSlider" Grid.Column="1" Minimum="250" Maximum="5000" TickFrequency="250"
                                        VerticalAlignment="Center" ValueChanged="RefreshSlider_ValueChanged" />
                                <TextBlock x:Name="RefreshText" Grid.Column="2" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="CSV log interval" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="How often History → Record CSV writes a row." Style="{StaticResource Muted}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="LogIntervalButtons" Orientation="Horizontal" AutomationProperties.Name="CSV log interval">
                                        <RadioButton Style="{StaticResource Segment}" Content="1 s" Tag="1" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="5 s" Tag="5" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="10 s" Tag="10" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="1 min" Tag="60" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <CheckBox x:Name="KeepHistorySwitch" Style="{StaticResource Switch}" Margin="0,12,0,0"
                                      Checked="KeepHistory_Changed" Unchecked="KeepHistory_Changed">
                                <StackPanel>
                                    <TextBlock Text="Keep 24 hours of history" />
                                    <TextBlock Text="Saves one-minute averages next to your settings, so graphs survive a restart (about 6 KB per sensor)."
                                               Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,-4,0,12"
                                       Text="These work everywhere, even in games, so other programs can't use them while Kelvra runs. Click a box and press the new keys · Backspace turns a shortcut off · Esc cancels." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Show / hide overlays" Style="{StaticResource FieldLabel}" />
                                <local:HotkeyBox x:Name="HotkeyOverlaysBox" Grid.Column="1" AutomationProperties.Name="Shortcut to show or hide overlays" />
                                <TextBlock x:Name="HotkeyOverlaysNote" Grid.Column="2" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="Lock / unlock overlays" Style="{StaticResource FieldLabel}" />
                                <local:HotkeyBox x:Name="HotkeyLockBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Shortcut to lock or unlock overlays" />
                                <TextBlock x:Name="HotkeyLockNote" Grid.Row="2" Grid.Column="2" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Text="Show / hide gaming overlay" Style="{StaticResource FieldLabel}" />
                                <local:HotkeyBox x:Name="HotkeyGameOverlaysBox" Grid.Row="4" Grid.Column="1" AutomationProperties.Name="Shortcut to show or hide the gaming overlay" />
                                <TextBlock x:Name="HotkeyGameOverlaysNote" Grid.Row="4" Grid.Column="2" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="6" Text="Start / stop benchmark" Style="{StaticResource FieldLabel}" />
                                <local:HotkeyBox x:Name="HotkeyBenchmarkBox" Grid.Row="6" Grid.Column="1" AutomationProperties.Name="Shortcut to start or stop a benchmark" />
                                <TextBlock x:Name="HotkeyBenchmarkNote" Grid.Row="6" Grid.Column="2" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sensor driver" Style="{StaticResource H2}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="PawnIO" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="PawnIoStatus" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="SettingsInstallButton" Grid.Column="1" Content="Install" Style="{StaticResource AccentButton}"
                                        VerticalAlignment="Center" Click="InstallPawnIo_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Gaming" Style="{StaticResource H2}" />
                            <CheckBox x:Name="GameFpsSwitch" Style="{StaticResource Switch}" Checked="GameFps_Changed" Unchecked="GameFps_Changed">
                                <StackPanel>
                                    <TextBlock Text="Measure FPS in games" />
                                    <TextBlock Text="Uses Intel PresentMon to read frame times. Powers the gaming overlay, the Game sensors and game sessions."
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="GameFpsStatus" Style="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Always a game" Style="{StaticResource FieldLabel}"
                                           ToolTip="For games Kelvra doesn&apos;t find by itself (e.g. windowed games outside a store library)" />
                                <TextBox x:Name="GameAlwaysBox" Grid.Column="1" Tag="e.g. Dying Light 2, War Thunder" LostFocus="GameLists_LostFocus"
                                         AutomationProperties.Name="Programs that always count as games" />
                                <TextBlock Grid.Row="2" Text="Never a game" Style="{StaticResource FieldLabel}"
                                           ToolTip="Programs that draw a lot but aren't games (3D tools, video players …)" />
                                <TextBox x:Name="GameNeverBox" Grid.Row="2" Grid.Column="1" Tag="e.g. blender" LostFocus="GameLists_LostFocus"
                                         AutomationProperties.Name="Programs that never count as games" />
                            </Grid>
                            <TextBlock x:Name="GameSeenText" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Game names, install folder names or exe names, separated by commas. Games from Steam, Epic, GOG, Xbox, EA and Ubisoft libraries are found by themselves, also windowed. Overlays can't draw over true exclusive fullscreen; borderless and most modern DirectX 12 / Vulkan games work." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Window" Style="{StaticResource H2}" />
                            <CheckBox x:Name="StartWithWindowsSwitch" Style="{StaticResource Switch}"
                                      Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Text="Starts in the tray when you sign in (with admin rights, no UAC prompt)." Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="StartMinimizedSwitch" Style="{StaticResource Switch}" Content="Start minimized to the tray"
                                      Checked="BehaviourSwitch_Changed" Unchecked="BehaviourSwitch_Changed" />
                            <CheckBox x:Name="CloseToTraySwitch" Style="{StaticResource Switch}" Content="Close button keeps Kelvra running in the tray"
                                      Checked="BehaviourSwitch_Changed" Unchecked="BehaviourSwitch_Changed" />
                            <CheckBox x:Name="MinimizeToTraySwitch" Style="{StaticResource Switch}" Content="Minimise button hides Kelvra in the tray"
                                      Checked="BehaviourSwitch_Changed" Unchecked="BehaviourSwitch_Changed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource H2}" />
                            <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" FontSize="13" LineHeight="20" />
                            <CheckBox x:Name="CheckUpdatesSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0"
                                      Checked="CheckUpdates_Changed" Unchecked="CheckUpdates_Changed">
                                <StackPanel>
                                    <TextBlock Text="Check for updates automatically" />
                                    <TextBlock Text="Asks GitHub once a day whether a newer Kelvra exists. Nothing about your PC is sent."
                                               Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="CheckUpdatesButton" Margin="0,0,8,0" Click="CheckForUpdates_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock x:Name="CheckUpdatesButtonText" Text="Check for updates" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,0" Click="CopyDiagnostics_Click"
                                        ToolTip="Versions, detected hardware and the end of the log, for a bug report. Your user name is removed; nothing is sent anywhere.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Copy diagnostics" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Open log folder" Margin="0,0,8,0" Click="OpenLogFolder_Click" />
                                <Button Content="Open settings folder" Click="OpenSettingsFolder_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- toast -->
            <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26" Padding="16,10"
                    CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <TextBlock x:Name="ToastText" />
            </Border>
        </Grid>
    </Grid>
</Window>
