<Window x:Class="Kelvra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kelvra"
        Title="Kelvra" Width="1360" Height="880" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <local:MatchConverter x:Key="Match" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="PaletteBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource SubtleBrush}"
                                       Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar: 14 labelled pages in four groups, search, mini mode and settings ================= -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,10">
                <!-- brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,14">
                    <!-- the app icon's gauge as vectors (same shapes as Assets\app.ico), sharp at any scale -->
                    <Image Width="26" Height="26" ToolTip="Kelvra · hardware monitor &amp; overlays">
                        <Image.Source>
                            <DrawingImage>
                                <DrawingImage.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#14171B"
                                                         Geometry="M60,8 H196 A52,52 0 0 1 248,60 V196 A52,52 0 0 1 196,248 H60 A52,52 0 0 1 8,196 V60 A52,52 0 0 1 60,8 Z" />
                                        <GeometryDrawing Geometry="M201.41,116.33 A76,76 0 0 1 181.74,189.74">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#2A3038" Thickness="32" StartLineCap="Round" EndLineCap="Round" />
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                        <GeometryDrawing Geometry="M74.26,189.74 A76,76 0 1 1 201.41,116.33">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#FF7B47" Thickness="32" StartLineCap="Round" EndLineCap="Round" />
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                        <GeometryDrawing Geometry="M128,136 L172.43,124.09">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#E8EBEF" Thickness="18" StartLineCap="Round" EndLineCap="Round" />
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#E8EBEF">
                                            <GeometryDrawing.Geometry>
                                                <EllipseGeometry Center="128,136" RadiusX="19" RadiusY="19" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FF7B47">
                                            <GeometryDrawing.Geometry>
                                                <EllipseGeometry Center="128,136" RadiusX="8.5" RadiusY="8.5" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingImage.Drawing>
                            </DrawingImage>
                        </Image.Source>
                    </Image>
                    <TextBlock Text="Kelvra" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="SearchButton" DockPanel.Dock="Top" Style="{StaticResource SearchLauncher}" Click="Search_Click" Margin="0,0,0,4"
                        AutomationProperties.Name="Search sensors, pages and actions (Ctrl K)" ToolTip="Find any sensor, page or action" />

                <!-- bottom: overlay quick controls, mini mode, settings -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,8,0,8" />
                    <Grid Margin="10,0,0,4">
                        <TextBlock Text="Overlays" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="OverlaysSwitch" Style="{StaticResource RailButton}" Content="&#xE890;" Width="32" Height="30" FontSize="14"
                                      Checked="OverlaysSwitch_Changed" Unchecked="OverlaysSwitch_Changed" />
                            <Button x:Name="LockAllButton" Style="{StaticResource RailButton}" Content="&#xE785;" Width="32" Height="30" FontSize="14"
                                    Click="LockAll_Click" />
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource NavAction}" Tag="&#xE73F;" Content="Mini mode" Click="Mini_Click"
                            ToolTip="A small window with the essentials, for a second screen" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 GroupName="Nav" Checked="Nav_Checked" />
                </StackPanel>

                <!-- Scrolls (wheel/keyboard) when the window is too short for every page -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="MONITOR" Style="{StaticResource RailGroup}" Margin="8,6,0,3" />
                        <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="&#xEC4A;" Content="Overview"
                                     GroupName="Nav" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSensors" Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="Sensors"
                                     GroupName="Nav" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="&#xE9D2;" Content="Graphs"
                                     GroupName="Nav" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavFans" Style="{StaticResource NavButton}" Tag="&#xE9CA;" Content="Fans"
                                     GroupName="Nav" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAlerts" Style="{StaticResource NavButton}" Tag="&#xEA8F;" Content="Alerts"
                                     GroupName="Nav" Checked="Nav_Checked" />

                        <TextBlock Text="GAMING" Style="{StaticResource RailGroup}" />
                        <RadioButton x:Name="NavGames" Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Games"
                                     GroupName="Nav" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavOverlays" Style="{StaticResource NavButton}" Tag="&#xE81E;" Content="Overlays"
                                     GroupName="Nav" Checked="Nav_Checked" />

                        <TextBlock Text="HISTORY" Style="{StaticResource RailGroup}" />
                        <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}" Tag="&#xE787;" Content="Reports"
                                     GroupName="Nav" Checked="Nav_Checked" />
                        <Grid>
                            <RadioButton x:Name="NavCrashes" Style="{StaticResource NavButton}" Tag="&#xE7BA;" Content="Crashes"
                                         GroupName="Nav" Checked="Nav_Checked" />
                            <!-- crashes since the page was last opened -->
                            <TextBlock x:Name="CrashBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CritBrush}" IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                        <RadioButton x:Name="NavChanges" Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="Changes"
                                     GroupName="Nav" Checked="Nav_Checked" />

                        <TextBlock Text="TOOLS" Style="{StaticResource RailGroup}" />
                        <RadioButton x:Name="NavDisk" Style="{StaticResource NavButton}" Tag="&#xEDA2;" Content="Disk"
                                     GroupName="Nav" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavCleanup" Style="{StaticResource NavButton}" Tag="&#xE74D;" Content="Cleanup"
                                     GroupName="Nav" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavProcesses" Style="{StaticResource NavButton}" Tag="&#xECAA;" Content="Processes"
                                     GroupName="Nav" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavStartup" Style="{StaticResource NavButton}" Tag="&#xE7E8;" Content="Startup"
                                     GroupName="Nav" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSystem" Style="{StaticResource NavButton}" Tag="&#xE977;" Content="System"
                                     GroupName="Nav" Checked="Nav_Checked" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Pages ================= -->
        <Grid Grid.Column="1">

            <local:OverviewPage x:Name="OverviewPage" />

            <!-- Sensors -->
            <local:SensorsPage x:Name="SensorsPage" Visibility="Collapsed" />

            <local:HistoryPage x:Name="HistoryPage" Visibility="Collapsed" />
            <local:GamesPage x:Name="GamesPage" Visibility="Collapsed" />
            <local:ReportsPage x:Name="ReportsPage" Visibility="Collapsed" />
            <local:CrashesPage x:Name="CrashesPage" Visibility="Collapsed" />
            <local:ChangesPage x:Name="ChangesPage" Visibility="Collapsed" />
            <local:AlertsPage x:Name="AlertsPage" Visibility="Collapsed" />
            <local:SystemPage x:Name="SystemPage" Visibility="Collapsed" />
            <local:AppsPage x:Name="AppsPage" Visibility="Collapsed" />

            <!-- Disk usage -->
            <local:DiskPage x:Name="DiskPage" Visibility="Collapsed" />

            <!-- Overlays -->
            <local:FansPage x:Name="FansPage" Visibility="Collapsed" />
            <local:OverlaysPage x:Name="OverlaysPage" Visibility="Collapsed" />

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,20" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,20" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource H2}" />
                            <Grid>
                                <TextBlock Text="App theme" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" Content="System" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" Content="Dark" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" Content="Light" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                                    <TextBlock Text="Accent colour" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                               Text="Any colour you like. Text and lines in it are kept readable on the dark and the light theme." />
                                </StackPanel>
                                <local:ColorField x:Name="AccentField" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Accent colour" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Temperature unit" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="UnitCelsius" Style="{StaticResource Segment}" Content="°C  Celsius" GroupName="Unit"
                                                     Checked="Unit_Checked" />
                                        <RadioButton x:Name="UnitFahrenheit" Style="{StaticResource Segment}" Content="°F  Fahrenheit" GroupName="Unit"
                                                     Checked="Unit_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Monitoring" Style="{StaticResource H2}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Refresh interval" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="RefreshSlider" Grid.Column="1" Minimum="250" Maximum="5000" TickFrequency="250"
                                        VerticalAlignment="Center" ValueChanged="RefreshSlider_ValueChanged" />
                                <TextBlock x:Name="RefreshText" Grid.Column="2" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="CSV log interval" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="How often Live graphs → Record CSV writes a row." Style="{StaticResource Muted}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="LogIntervalButtons" Orientation="Horizontal" AutomationProperties.Name="CSV log interval">
                                        <RadioButton Style="{StaticResource Segment}" Content="1 s" Tag="1" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="5 s" Tag="5" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="10 s" Tag="10" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="1 min" Tag="60" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <CheckBox x:Name="KeepHistorySwitch" Style="{StaticResource Switch}" Margin="0,12,0,0"
                                      Checked="KeepHistory_Changed" Unchecked="KeepHistory_Changed">
                                <StackPanel>
                                    <TextBlock Text="Keep the live graphs over a restart" />
                                    <TextBlock Text="Saves the last 24 hours of one-minute averages next to your settings (about 6 KB per sensor)."
                                               Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="History" Style="{StaticResource H2}" />
                            <CheckBox x:Name="LongHistorySwitch" Style="{StaticResource Switch}" Checked="LongHistory_Changed" Unchecked="LongHistory_Changed">
                                <StackPanel>
                                    <TextBlock Text="Record history" />
                                    <TextBlock Text="Key temperatures, loads and fans, app use, crashes and changes, for Reports, Crashes and Changes. Also while Kelvra is in the tray; stays on this PC."
                                               Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                            <Grid Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Minute-by-minute detail" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Day totals are kept for good; this is how long the detail behind day charts stays." Style="{StaticResource Muted}" />
                                </StackPanel>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="MinuteDaysButtons" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="7 days" Tag="7" GroupName="MinuteDays" Checked="MinuteDays_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="30 days" Tag="30" GroupName="MinuteDays" Checked="MinuteDays_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="90 days" Tag="90" GroupName="MinuteDays" Checked="MinuteDays_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <CheckBox x:Name="AppNetworkSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0"
                                      Checked="AppNetwork_Changed" Unchecked="AppNetwork_Changed">
                                <StackPanel>
                                    <TextBlock Text="Count each app's internet use" />
                                    <TextBlock x:Name="AppNetworkNote" Style="{StaticResource Muted}"
                                               Text="Reads Windows' own network events (what Resource Monitor shows). Bytes only: never addresses or content." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource DangerButton}" Content="Clear history…" Click="ClearHistory_Click" />
                                <TextBlock x:Name="HistorySizeText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,-4,0,12"
                                       Text="These work everywhere, even in games, so other programs can't use them while Kelvra runs. Click a box and press the new keys · Backspace turns a shortcut off · Esc cancels." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Show / hide overlays" Style="{StaticResource FieldLabel}" />
                                <local:HotkeyBox x:Name="HotkeyOverlaysBox" Grid.Column="1" AutomationProperties.Name="Shortcut to show or hide overlays" />
                                <TextBlock x:Name="HotkeyOverlaysNote" Grid.Column="2" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="Lock / unlock overlays" Style="{StaticResource FieldLabel}" />
                                <local:HotkeyBox x:Name="HotkeyLockBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Shortcut to lock or unlock overlays" />
                                <TextBlock x:Name="HotkeyLockNote" Grid.Row="2" Grid.Column="2" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Text="Show / hide gaming overlay" Style="{StaticResource FieldLabel}" />
                                <local:HotkeyBox x:Name="HotkeyGameOverlaysBox" Grid.Row="4" Grid.Column="1" AutomationProperties.Name="Shortcut to show or hide the gaming overlay" />
                                <TextBlock x:Name="HotkeyGameOverlaysNote" Grid.Row="4" Grid.Column="2" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="6" Text="Start / stop benchmark" Style="{StaticResource FieldLabel}" />
                                <local:HotkeyBox x:Name="HotkeyBenchmarkBox" Grid.Row="6" Grid.Column="1" AutomationProperties.Name="Shortcut to start or stop a benchmark" />
                                <TextBlock x:Name="HotkeyBenchmarkNote" Grid.Row="6" Grid.Column="2" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sensor driver" Style="{StaticResource H2}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="PawnIO" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="PawnIoStatus" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="SettingsInstallButton" Grid.Column="1" Content="Install" Style="{StaticResource AccentButton}"
                                        VerticalAlignment="Center" Click="InstallPawnIo_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Gaming" Style="{StaticResource H2}" />
                            <CheckBox x:Name="GameFpsSwitch" Style="{StaticResource Switch}" Checked="GameFps_Changed" Unchecked="GameFps_Changed">
                                <StackPanel>
                                    <TextBlock Text="Measure FPS in games" />
                                    <TextBlock Text="Uses Intel PresentMon to read frame times. Powers the gaming overlay, the Game sensors and game sessions."
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="GameFpsStatus" Style="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Always a game" Style="{StaticResource FieldLabel}"
                                           ToolTip="For games Kelvra doesn&apos;t find by itself (e.g. windowed games outside a store library)" />
                                <TextBox x:Name="GameAlwaysBox" Grid.Column="1" Tag="e.g. Dying Light 2, War Thunder" LostFocus="GameLists_LostFocus"
                                         AutomationProperties.Name="Programs that always count as games" />
                                <TextBlock Grid.Row="2" Text="Never a game" Style="{StaticResource FieldLabel}"
                                           ToolTip="Programs that draw a lot but aren't games (3D tools, video players …)" />
                                <TextBox x:Name="GameNeverBox" Grid.Row="2" Grid.Column="1" Tag="e.g. blender" LostFocus="GameLists_LostFocus"
                                         AutomationProperties.Name="Programs that never count as games" />
                            </Grid>
                            <TextBlock x:Name="GameSeenText" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Game names, install folder names or exe names, separated by commas. Games from Steam, Epic, GOG, Xbox, EA and Ubisoft libraries are found by themselves, also windowed. Overlays can't draw over true exclusive fullscreen; borderless and most modern DirectX 12 / Vulkan games work." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Window" Style="{StaticResource H2}" />
                            <CheckBox x:Name="StartWithWindowsSwitch" Style="{StaticResource Switch}"
                                      Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Text="Starts in the tray when you sign in (with admin rights, no UAC prompt)." Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="StartMinimizedSwitch" Style="{StaticResource Switch}" Content="Start minimized to the tray"
                                      Checked="BehaviourSwitch_Changed" Unchecked="BehaviourSwitch_Changed" />
                            <CheckBox x:Name="CloseToTraySwitch" Style="{StaticResource Switch}" Content="Close button keeps Kelvra running in the tray"
                                      Checked="BehaviourSwitch_Changed" Unchecked="BehaviourSwitch_Changed" />
                            <CheckBox x:Name="MinimizeToTraySwitch" Style="{StaticResource Switch}" Content="Minimise button hides Kelvra in the tray"
                                      Checked="BehaviourSwitch_Changed" Unchecked="BehaviourSwitch_Changed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource H2}" />
                            <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" FontSize="13" LineHeight="20" />
                            <CheckBox x:Name="CheckUpdatesSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0"
                                      Checked="CheckUpdates_Changed" Unchecked="CheckUpdates_Changed">
                                <StackPanel>
                                    <TextBlock Text="Check for updates automatically" />
                                    <TextBlock Text="Asks GitHub once a day whether a newer Kelvra exists. Nothing about your PC is sent."
                                               Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="CheckUpdatesButton" Margin="0,0,8,0" Click="CheckForUpdates_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock x:Name="CheckUpdatesButtonText" Text="Check for updates" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,0" Click="CopyDiagnostics_Click"
                                        ToolTip="Versions, detected hardware and the end of the log, for a bug report. Your user name is removed; nothing is sent anywhere.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Copy diagnostics" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Open log folder" Margin="0,0,8,0" Click="OpenLogFolder_Click" />
                                <Button Content="Open settings folder" Click="OpenSettingsFolder_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- toast -->
            <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26" Padding="16,10"
                    CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <TextBlock x:Name="ToastText" />
            </Border>
        </Grid>
        <!-- ================= Ctrl K: one search box for sensors, pages and actions ================= -->
        <Grid x:Name="Palette" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#73000000" MouseLeftButtonDown="PaletteBackdrop_MouseDown">
            <Border Width="640" VerticalAlignment="Top" Margin="0,84,0,0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="PaletteCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,14,18,12">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource MutedBrush}" />
                        <TextBox x:Name="PaletteBox" Style="{StaticResource PaletteBoxStyle}" Margin="30,0,0,0" FontSize="17"
                                 Tag="Search sensors, pages and actions…" AutomationProperties.Name="Search"
                                 TextChanged="PaletteBox_TextChanged" PreviewKeyDown="PaletteBox_PreviewKeyDown" />
                    </Grid>
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource LineBrush}" />
                    <TextBlock DockPanel.Dock="Bottom" Margin="18,8,18,12" Style="{StaticResource Muted}" FontSize="11"
                               Text="↑ ↓ to choose · Enter to open · Esc to close" />
                    <ScrollViewer x:Name="PaletteScroller" MaxHeight="440" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="PaletteList" Margin="8,6,8,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PaletteItem}">
                                    <Grid>
                                        <TextBlock x:Name="Header" Text="{Binding Title}" Style="{StaticResource Overline}" Margin="12,10,0,4"
                                                   Visibility="Collapsed" />
                                        <Border x:Name="Row" CornerRadius="8" Padding="12,9" Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonUp="PaletteRow_MouseUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14"
                                                           Foreground="{Binding IconBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                                           TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="Header" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
