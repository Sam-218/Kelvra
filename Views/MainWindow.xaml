<Window x:Class="Kelvra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kelvra"
        Title="Kelvra" Width="1120" Height="740" MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <local:MatchConverter x:Key="Match" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,24">
                    <Image Source="/Assets/app.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Kelvra" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Hardware monitor &amp; OSD" Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: quick overlay controls -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,8,12,12">
                    <StackPanel>
                        <CheckBox x:Name="OverlaysSwitch" Style="{StaticResource Switch}" Content="Overlays"
                                  Checked="OverlaysSwitch_Changed" Unchecked="OverlaysSwitch_Changed" />
                        <Button x:Name="LockAllButton" Content="Unlock to move" Margin="0,6,0,0" Click="LockAll_Click" />
                        <TextBlock Text="Ctrl+Shift+O  show / hide&#10;Ctrl+Shift+L  lock / unlock" Style="{StaticResource Muted}"
                                   FontSize="11" Margin="0,10,0,0" LineHeight="17" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavSensors" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Sensors"
                                 GroupName="Nav" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavCategories" Style="{StaticResource NavButton}" Tag="&#xE71C;" Content="Categories"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="History"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAlerts" Style="{StaticResource NavButton}" Tag="&#xEA8F;" Content="Alerts"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSystem" Style="{StaticResource NavButton}" Tag="&#xE977;" Content="System"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavButton}" Tag="&#xECAA;" Content="Apps"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDisk" Style="{StaticResource NavButton}" Tag="&#xEDA2;" Content="Disk"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavOverlays" Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="Overlays"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 GroupName="Nav" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Pages ================= -->
        <Grid Grid.Column="1">

            <!-- Sensors -->
            <local:SensorsPage x:Name="SensorsPage" />

            <!-- Categories -->
            <local:CategoriesPage x:Name="CategoriesPage" Visibility="Collapsed" />

            <local:HistoryPage x:Name="HistoryPage" Visibility="Collapsed" />
            <local:AlertsPage x:Name="AlertsPage" Visibility="Collapsed" />
            <local:SystemPage x:Name="SystemPage" Visibility="Collapsed" />
            <local:AppsPage x:Name="AppsPage" Visibility="Collapsed" />

            <!-- Disk usage -->
            <local:DiskPage x:Name="DiskPage" Visibility="Collapsed" />

            <!-- Overlays -->
            <Grid x:Name="OverlaysPage" Margin="28,24,28,20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
                    <TextBlock Text="Overlays" Style="{StaticResource H1}" />
                    <TextBlock Text="Build as many on-screen overlays as you like. Each one has its own sensors, position and style."
                               Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- overlay list -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="6,4,6,8">
                            <TextBlock Text="NEW OVERLAY" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel x:Name="TemplateButtons" />
                        </StackPanel>
                        <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource LineBrush}" Margin="4,4,4,8" />
                        <ListBox x:Name="OverlayList" SelectionChanged="OverlayList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:OverlayProfile}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"
                                                  Margin="0" ToolTip="Show this overlay" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- empty state -->
                <Border x:Name="NoOverlaySelected" Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="Pick an overlay on the left, or create a new one." Style="{StaticResource Muted}"
                                   FontSize="13" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- editor -->
                <ScrollViewer x:Name="Editor" Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,0">

                        <!-- header -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold"
                                         Tag="Overlay name" MaxWidth="360" HorizontalAlignment="Left" MinWidth="220" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Click="Duplicate_Click" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="Duplicate" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="Delete" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- sensors -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Sensors" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Type a place, get a clock for its time zone (summer/winter time included) -->
                                        <TextBox x:Name="PlaceBox" Width="190" Tag="Clock for a place, e.g. Minnesota" KeyDown="PlaceBox_KeyDown"
                                                 ToolTip="Type a country, state or city and press Enter to add its local time" />
                                        <Button Click="AddPlace_Click" Margin="6,0,8,0" ToolTip="Add a clock for this place">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="Add clock" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource AccentButton}" Click="AddSensors_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="Add sensors" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="NoItemsText" Text="No sensors yet. Click “Add sensors”, or use the + button on the Sensors page."
                                           Style="{StaticResource Muted}" Margin="0,4" />
                                <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:OverlayItem}">
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Width="26" Height="26"
                                                                Click="MoveUp_Click" ToolTip="Move up" />
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Width="26" Height="26"
                                                                Click="MoveDown_Click" ToolTip="Move down" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SensorName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding HardwareName}" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBox Grid.Column="2" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                             Tag="Custom label" VerticalAlignment="Center" />
                                                    <CheckBox Grid.Column="3" Content="Bar" IsChecked="{Binding ShowBar}" Margin="14,0,6,0"
                                                              VerticalAlignment="Center" ToolTip="Show a progress bar under the value" />
                                                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;"
                                                            Click="RemoveItem_Click" ToolTip="Remove" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- behaviour -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Behaviour" Style="{StaticResource H2}" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="Show this overlay" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Locked}">
                                    <StackPanel>
                                        <TextBlock Text="Locked (click-through)" />
                                        <TextBlock Text="Turn off to drag the overlay around with the mouse." Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowHeaders}" Content="Show hardware headers" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ClockSeconds}" Content="Show seconds on time zone clocks" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WarnColors}">
                                    <StackPanel>
                                        <TextBlock Text="Warning colours" />
                                        <TextBlock Text="Yellow / red when temperatures pass 70 / 85 °C or load passes 80 / 95 %."
                                                   Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- appearance -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Appearance" Style="{StaticResource H2}" Grid.ColumnSpan="3" />

                                <TextBlock Grid.Row="1" Text="Layout" Style="{StaticResource FieldLabel}" />
                                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="Vertical" GroupName="Layout"
                                                     IsChecked="{Binding Layout, Converter={StaticResource Match}, ConverterParameter=Vertical}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Horizontal" GroupName="Layout"
                                                     IsChecked="{Binding Layout, Converter={StaticResource Match}, ConverterParameter=Horizontal}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="2" Text="Font" Style="{StaticResource FieldLabel}" />
                                <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="Segoe UI" GroupName="Font" FontFamily="Segoe UI"
                                                     IsChecked="{Binding FontFamily, Converter={StaticResource Match}, ConverterParameter='Segoe UI'}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Bahnschrift" GroupName="Font" FontFamily="Bahnschrift"
                                                     IsChecked="{Binding FontFamily, Converter={StaticResource Match}, ConverterParameter=Bahnschrift}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Consolas" GroupName="Font" FontFamily="Consolas"
                                                     IsChecked="{Binding FontFamily, Converter={StaticResource Match}, ConverterParameter=Consolas}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Cascadia Mono" GroupName="Font" FontFamily="Cascadia Mono"
                                                     IsChecked="{Binding FontFamily, Converter={StaticResource Match}, ConverterParameter='Cascadia Mono'}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="3" Text="Font size" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="8" Maximum="28" TickFrequency="1" VerticalAlignment="Center"
                                        Value="{Binding FontSize}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding FontSize, StringFormat={}{0:0} pt}"
                                           Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="4" Text="Background opacity" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" VerticalAlignment="Center"
                                        Value="{Binding BackgroundOpacity}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding BackgroundOpacity, StringFormat={}{0} %}"
                                           Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="5" Text="Corner radius" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="20" TickFrequency="1" VerticalAlignment="Center"
                                        Value="{Binding CornerRadius}" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding CornerRadius, StringFormat={}{0} px}"
                                           Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" />

                                <UniformGrid Grid.Row="6" Grid.ColumnSpan="3" Columns="2" Margin="0,14,0,0">
                                    <StackPanel Margin="0,0,12,14">
                                        <TextBlock Text="Background" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <local:ColorField Value="{Binding BackgroundColor}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="Headers" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <local:ColorField Value="{Binding AccentColor}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Labels" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <local:ColorField Value="{Binding LabelColor}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Values" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <local:ColorField Value="{Binding ValueColor}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,20" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,20" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource H2}" />
                            <Grid>
                                <TextBlock Text="App theme" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" Content="System" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" Content="Dark" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" Content="Light" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Temperature unit" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="UnitCelsius" Style="{StaticResource Segment}" Content="°C  Celsius" GroupName="Unit"
                                                     Checked="Unit_Checked" />
                                        <RadioButton x:Name="UnitFahrenheit" Style="{StaticResource Segment}" Content="°F  Fahrenheit" GroupName="Unit"
                                                     Checked="Unit_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Monitoring" Style="{StaticResource H2}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Refresh interval" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="RefreshSlider" Grid.Column="1" Minimum="250" Maximum="5000" TickFrequency="250"
                                        VerticalAlignment="Center" ValueChanged="RefreshSlider_ValueChanged" />
                                <TextBlock x:Name="RefreshText" Grid.Column="2" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="CSV log interval" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="How often History → Record CSV writes a row." Style="{StaticResource Muted}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="LogIntervalButtons" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="1 s" Tag="1" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="5 s" Tag="5" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="10 s" Tag="10" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" Content="1 min" Tag="60" GroupName="LogInterval" Checked="LogInterval_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sensor driver" Style="{StaticResource H2}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="PawnIO" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="PawnIoStatus" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="SettingsInstallButton" Grid.Column="1" Content="Install" Style="{StaticResource AccentButton}"
                                        VerticalAlignment="Center" Click="InstallPawnIo_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Window" Style="{StaticResource H2}" />
                            <CheckBox x:Name="StartWithWindowsSwitch" Style="{StaticResource Switch}"
                                      Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Text="Starts in the tray when you sign in (with admin rights, no UAC prompt)." Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="AutostartWarning" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,8"
                                       Foreground="{DynamicResource HotBrush}"
                                       Text="⚠ Kelvra.exe is in a folder other programs can change, so the sign-in task isn't updated anymore. Move Kelvra.exe to C:\Program Files\Kelvra and start it from there." />
                            <CheckBox x:Name="StartMinimizedSwitch" Style="{StaticResource Switch}" Content="Start minimized to the tray"
                                      Checked="BehaviourSwitch_Changed" Unchecked="BehaviourSwitch_Changed" />
                            <CheckBox x:Name="CloseToTraySwitch" Style="{StaticResource Switch}" Content="Close button keeps Kelvra running in the tray"
                                      Checked="BehaviourSwitch_Changed" Unchecked="BehaviourSwitch_Changed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource H2}" />
                            <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" FontSize="13" LineHeight="20" />
                            <Button Content="Open settings folder" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenSettingsFolder_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- toast -->
            <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26" Padding="16,10"
                    CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <TextBlock x:Name="ToastText" />
            </Border>
        </Grid>
    </Grid>
</Window>
