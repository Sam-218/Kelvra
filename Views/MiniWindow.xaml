<Window x:Class="Kelvra.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kelvra"
        Title="Kelvra mini" Width="360" Height="330" MinWidth="300" MinHeight="200"
        WindowStyle="None" ResizeMode="CanResize" Icon="/Assets/app.ico" ShowInTaskbar="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- Own title bar: the whole top strip drags the window, the edges resize it -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:HeatBrushConverter x:Key="HeatBrush" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <DockPanel>
            <!-- title bar -->
            <Grid DockPanel.Dock="Top" Height="40">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Kelvra" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{DynamicResource GoodBrush}" Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <ToggleButton x:Name="OverlaysButton" Style="{StaticResource RailButton}" Width="32" Height="32" FontSize="13"
                                  WindowChrome.IsHitTestVisibleInChrome="True" Click="Overlays_Click" AutomationProperties.Name="Show overlays"
                                  ToolTipService.Placement="Bottom" />
                    <ToggleButton x:Name="LockButton" Style="{StaticResource RailButton}" Width="32" Height="32" FontSize="13"
                                  WindowChrome.IsHitTestVisibleInChrome="True" Click="Lock_Click" AutomationProperties.Name="Overlays can be moved"
                                  ToolTipService.Placement="Bottom" />
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource LineBrush}" Margin="4,0" />
                    <ToggleButton x:Name="PinButton" Style="{StaticResource RailButton}" Content="&#xE718;" Width="32" Height="32" FontSize="13"
                                  WindowChrome.IsHitTestVisibleInChrome="True" Checked="Pin_Changed" Unchecked="Pin_Changed"
                                  ToolTipService.Placement="Bottom" />
                    <Button Style="{StaticResource RailButton}" Content="&#xE740;" Width="32" Height="32" FontSize="13"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OpenFull_Click" ToolTip="Open the full Kelvra window"
                            AutomationProperties.Name="Open the full Kelvra window" ToolTipService.Placement="Bottom" />
                    <Button Style="{StaticResource RailButton}" Content="&#xE8BB;" Width="32" Height="32" FontSize="12"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close mini mode"
                            AutomationProperties.Name="Close mini mode" ToolTipService.Placement="Bottom" />
                </StackPanel>
            </Grid>

            <!-- 2 × 2 tiles: CPU, GPU, memory, network (more rows with a second GPU) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="Cards" Margin="10,0,2,2" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MiniCard}">
                            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,8" ToolTip="{Binding Device}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Overline}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Hero}" Style="{StaticResource Hero}" FontSize="28"
                                                   Foreground="{Binding Heat, Converter={StaticResource HeatBrush}}" />
                                        <TextBlock Text="{Binding HeroUnit}" Style="{StaticResource Muted}" Margin="3,0,0,5" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <local:TrendChart Height="24" Margin="0,6,0,0" PrimaryId="{Binding SparkId}"
                                                      AutoScale="True" ShowGrid="False" WindowSeconds="300"
                                                      Fill="{DynamicResource AccentSoftBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
