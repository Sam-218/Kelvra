<Window x:Class="Kelvra.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kelvra"
        Title="Kelvra mini" Width="340" Height="620" MinWidth="280" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize" Icon="/Assets/app.ico" ShowInTaskbar="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- Own title bar: the whole top strip drags the window, the edges resize it -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <DockPanel>
            <!-- title bar -->
            <Grid DockPanel.Dock="Top" Height="40">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="KELVRA MINI" Style="{StaticResource Overline}" Margin="8,1,0,0" VerticalAlignment="Center" />
                    <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{DynamicResource GoodBrush}" Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource RailButton}" Content="&#xE718;" Width="32" Height="32" FontSize="13"
                                  WindowChrome.IsHitTestVisibleInChrome="True" Checked="Pin_Changed" Unchecked="Pin_Changed"
                                  ToolTipService.Placement="Bottom" />
                    <Button Style="{StaticResource RailButton}" Content="&#xE740;" Width="32" Height="32" FontSize="13"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OpenFull_Click" ToolTip="Open the full Kelvra window"
                            AutomationProperties.Name="Open the full Kelvra window" ToolTipService.Placement="Bottom" />
                    <Button Style="{StaticResource RailButton}" Content="&#xE8BB;" Width="32" Height="32" FontSize="12"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close mini mode"
                            AutomationProperties.Name="Close mini mode" ToolTipService.Placement="Bottom" />
                </StackPanel>
            </Grid>

            <!-- quick actions -->
            <Grid DockPanel.Dock="Bottom" Margin="10,6,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OverlaysButton" Height="38" Click="Overlays_Click" />
                <Button x:Name="LockButton" Grid.Column="2" Height="38" Click="Lock_Click" />
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="Cards" Margin="10,0,10,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MiniCard}">
                            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Overline}" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding Device}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="200" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" MinWidth="104" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Hero}" Style="{StaticResource Mono}" FontSize="26" />
                                            <TextBlock Text="{Binding HeroUnit}" Style="{StaticResource Muted}" Margin="4,0,0,4" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <local:TrendChart Grid.Column="1" Height="34" Margin="10,0,0,0" PrimaryId="{Binding SparkId}"
                                                          AutoScale="True" ShowGrid="False" WindowSeconds="300"
                                                          Fill="{DynamicResource AccentSoftBrush}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,8,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:StatCell}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Overline}" FontSize="10" />
                                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Mono}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
