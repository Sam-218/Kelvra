<Window x:Class="Kelvra.PawnIoPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kelvra" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="26,24,26,22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock x:Name="Heading" Text="Install the sensor driver?" Style="{StaticResource H1}" FontSize="19"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="20"
                   Text="Kelvra uses the free PawnIO driver to read CPU temperatures, voltages and fan speeds. Without it, those sensors show 0." />

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Muted}" FontSize="12" LineHeight="18">
                <Run Text="• Official, digitally signed installer from pawnio.eu (namazso)" /><LineBreak />
                <Run Text="• Takes a few seconds; Windows may ask for permission" /><LineBreak />
                <Run Text="• Can be removed any time from Windows “Installed apps”" />
            </TextBlock>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource HotBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="Collapsed" />

        <Grid Margin="0,22,0,0">
            <Button x:Name="NeverButton" Content="Don't ask again" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}" Click="Never_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Content="Not now" MinWidth="90" IsCancel="True" Click="Later_Click" />
                <Button x:Name="InstallButton" Content="Install" Style="{StaticResource AccentButton}" MinWidth="110"
                        Margin="8,0,0,0" IsDefault="True" Click="Install_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
