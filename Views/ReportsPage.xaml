<UserControl x:Class="Kelvra.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- a table's header row and its rows share these columns -->
        <Style x:Key="TableHead" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextElement.FontSize" Value="12" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,16">
        <!-- header: the period in one sentence -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock x:Name="Headline" Text="Reports" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Subline" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                    <StackPanel x:Name="RangeButtons" Orientation="Horizontal" AutomationProperties.Name="Report period">
                        <RadioButton Style="{StaticResource Segment}" Content="Day" Tag="Day" GroupName="ReportRange" Checked="Range_Checked" />
                        <RadioButton Style="{StaticResource Segment}" Content="Week" Tag="Week" GroupName="ReportRange" Checked="Range_Checked" />
                        <RadioButton Style="{StaticResource Segment}" Content="Month" Tag="Month" GroupName="ReportRange" Checked="Range_Checked" />
                        <RadioButton Style="{StaticResource Segment}" Content="Year" Tag="Year" GroupName="ReportRange" Checked="Range_Checked" />
                    </StackPanel>
                </Border>
                <Button Margin="12,0,0,0" Padding="10,6" FontFamily="{StaticResource IconFont}" FontSize="11" Content="&#xE76B;"
                        Click="Previous_Click" ToolTip="Earlier" AutomationProperties.Name="Earlier" />
                <Button x:Name="NextButton" Margin="6,0,0,0" Padding="10,6" FontFamily="{StaticResource IconFont}" FontSize="11" Content="&#xE76C;"
                        Click="Next_Click" ToolTip="Later" AutomationProperties.Name="Later" />
                <Button x:Name="NowButton" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Content="Back to now" Click="Now_Click" />
                <Button x:Name="CopyButton" Margin="12,0,0,0" Content="Copy summary" Click="Copy_Click"
                        ToolTip="Copies the report as plain text, for a forum post or a support chat" />
            </StackPanel>
        </Grid>

        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="0,0,0,0">
                    <!-- the numbers -->
                    <ItemsControl x:Name="Tiles" Focusable="False" Margin="0,0,-16,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:StatTile}">
                                <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Overline}" />
                                        <TextBlock Style="{StaticResource Hero}" FontSize="30" Margin="0,6,0,4" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Value, Mode=OneWay}" Foreground="{Binding ValueBrush, Mode=OneWay}" /><Run
                                                 Text="{Binding Unit, Mode=OneWay}" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource SubtleBrush}" /><Run
                                                 Text="{Binding Value2, Mode=OneWay}" Foreground="{Binding Value2Brush, Mode=OneWay}" /><Run
                                                 Text="{Binding Unit2, Mode=OneWay}" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource SubtleBrush}" />
                                        </TextBlock>
                                        <!-- left-aligned: the text takes what it needs (trimmed when too long), the chevron sits right after it -->
                                        <Grid HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" ToolTip="{Binding Sub}" />
                                            <!-- the crashes card opens the Crashes page -->
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="10" Width="20" Height="18" Margin="4,0,0,0"
                                                    Padding="0" Click="ShowCrashes_Click" ToolTip="Show on the Crashes page" AutomationProperties.Name="Show crashes"
                                                    Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- temperatures -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Temperatures" Style="{StaticResource H2}" FontSize="15" />
                                    <TextBlock x:Name="ChartNote" Style="{StaticResource Muted}" Foreground="{DynamicResource SubtleBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Rectangle Width="14" Height="2" Fill="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="CPU" Style="{StaticResource Muted}" Margin="0,0,14,0" />
                                    <Rectangle Width="14" Height="2" Fill="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="GPU" Style="{StaticResource Muted}" Margin="0,0,14,0" />
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource HotBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="HotNote" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </Grid>
                            <local:ReportChart x:Name="Chart" Height="300" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- apps -->
                        <Border x:Name="AppsCard" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Apps you used" Style="{StaticResource H2}" FontSize="15" />
                                    <TextBlock Text="temperatures while each was in front" Style="{StaticResource Muted}" FontSize="13"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Style="{StaticResource TableHead}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="App" />
                                    <TextBlock Grid.Column="1" Text="In front" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="2" Text="CPU avg" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="3" Text="GPU avg" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="4" Text="Downloaded" Style="{StaticResource Cell}"
                                               ToolTip="Every app's internet use, also in the background (Settings → History)" />
                                </Grid>
                                <ItemsControl x:Name="AppList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:AppRow}">
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="92" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Cell}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Cpu}" Foreground="{Binding CpuBrush}" Style="{StaticResource Cell}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Gpu}" Foreground="{Binding GpuBrush}" Style="{StaticResource Cell}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Down}" Style="{StaticResource Cell}" ToolTip="{Binding Up}"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="AppsEmpty" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="Collapsed"
                                           Text="No app was in front long enough to count." />
                            </StackPanel>
                        </Border>

                        <!-- games -->
                        <Border x:Name="GamesCard" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Games" Style="{StaticResource H2}" FontSize="15" />
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Style="{StaticResource TableHead}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Game" />
                                    <TextBlock Grid.Column="1" Text="Played" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="2" Text="Avg FPS" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="3" Text="1 % low" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="4" Text="Held back by" Style="{StaticResource Cell}"
                                               ToolTip="What limited the frame rate most of the time: the graphics card, the processor, or a frame cap / VSync" />
                                </Grid>
                                <ItemsControl x:Name="GameList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:GameRow}">
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="96" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Played}" Style="{StaticResource Cell}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Avg}" FontWeight="SemiBold" Style="{StaticResource Cell}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Low}" Foreground="{DynamicResource MutedBrush}" Style="{StaticResource Cell}" />
                                                    <Border Grid.Column="4" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Visibility="{Binding HasHeldBy, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding HeldBy}" Style="{StaticResource PillText}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="GamesEmpty" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="Collapsed"
                                           Text="No games played. Sessions are recorded while FPS measuring is on (Settings → Gaming)." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- worth knowing -->
                    <Border Style="{StaticResource Card}" x:Name="InsightsCard">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource WarnBrush}" />
                                <TextBlock Text="Worth knowing" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                            </StackPanel>
                            <ItemsControl x:Name="InsightList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:InsightRow}">
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding Brush}"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="19" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Visibility="Collapsed" MaxWidth="520" />
        </Grid>
    </DockPanel>
</UserControl>
