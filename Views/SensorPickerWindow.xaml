<Window x:Class="Kelvra.SensorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kelvra"
        Title="Add sensors" Width="680" Height="680" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <DockPanel Margin="22,18,22,18">
        <TextBlock DockPanel.Dock="Top" x:Name="Heading" Style="{StaticResource H1}" FontSize="20" />
        <TextBlock DockPanel.Dock="Top" x:Name="Hint" Text="Tick the sensors you want."
                   Style="{StaticResource Muted}" Margin="0,4,0,14" />
        <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Tag="Search sensors…" Margin="0,0,0,12" TextChanged="SearchBox_TextChanged" />

        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="CountText" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="13" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="90" />
                <Button x:Name="AddButton" Content="Add" Style="{StaticResource AccentButton}" IsDefault="True"
                        MinWidth="90" Margin="8,0,0,0" Click="Add_Click" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="6" Margin="0">
            <ListView x:Name="List" ItemContainerStyle="{StaticResource PlainRow}"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           Margin="10,12,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PickItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" Click="Check_Click">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                            <TextBlock Grid.Column="1" Text="{Binding Sensor.TypeLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Sensor.ValueText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </DockPanel>
</Window>
