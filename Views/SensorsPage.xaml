<UserControl x:Class="Kelvra.SensorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <DockPanel Margin="28,24,28,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Sensors" Style="{StaticResource H1}" />
                <TextBlock x:Name="Subtitle" Text="Detecting hardware…" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Width="280" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Tag="Search sensors…" TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Border x:Name="WarningBanner" DockPanel.Dock="Top" Background="{DynamicResource WarnSoftBrush}" CornerRadius="10"
                Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,10,0" />
                <TextBlock x:Name="WarningText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="BannerInstallButton" Grid.Column="2" Content="Install PawnIO" Style="{StaticResource AccentButton}"
                        Padding="12,5" Margin="12,0,0,0" Visibility="Collapsed" Click="BannerInstall_Click" />
            </Grid>
        </Border>

        <!-- Filter chips + fold controls -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel x:Name="ChipPanel" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ResetOrderButton" Style="{StaticResource GhostButton}" Padding="10,5" Click="ResetOrder_Click"
                        ToolTip="Put devices back in their original order" AutomationProperties.Name="Reset order" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="Reset order" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="10,5" Click="ExpandAll_Click" ToolTip="Unfold all groups" AutomationProperties.Name="Expand all">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="Expand all" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="10,5" Click="CollapseAll_Click" ToolTip="Fold all groups" AutomationProperties.Name="Collapse all">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="Collapse all" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="8,6,8,8" Margin="0">
            <DockPanel>
                <!-- sortable column headers -->
                <Grid DockPanel.Dock="Top" Margin="40,8,28,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SortName" Style="{StaticResource SortHeader}" Tag="Name" HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left" Click="SortHeader_Click" ToolTip="Sort by name" />
                    <Button x:Name="SortType" Grid.Column="1" Style="{StaticResource SortHeader}" Tag="TypeLabel" HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left" Click="SortHeader_Click" ToolTip="Sort by type" />
                    <Button x:Name="SortValue" Grid.Column="2" Style="{StaticResource SortHeader}" Tag="Value" HorizontalAlignment="Right"
                            HorizontalContentAlignment="Right" Click="SortHeader_Click" ToolTip="Sort by current value" />
                    <Button x:Name="SortMin" Grid.Column="3" Style="{StaticResource SortHeader}" Tag="Min" HorizontalAlignment="Right"
                            HorizontalContentAlignment="Right" Click="SortHeader_Click" ToolTip="Sort by minimum" />
                    <Button x:Name="SortMax" Grid.Column="4" Style="{StaticResource SortHeader}" Tag="Max" HorizontalAlignment="Right"
                            HorizontalContentAlignment="Right" Click="SortHeader_Click" ToolTip="Sort by maximum" />
                </Grid>
                <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource LineBrush}" Margin="8,0" />

                <Grid>
                    <ListView x:Name="SensorList" ItemContainerStyle="{StaticResource PlainRow}"
                              AllowDrop="True" DragOver="SensorList_DragOver" Drop="SensorList_Drop" DragLeave="SensorList_DragLeave"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander Style="{StaticResource GroupExpander}" IsExpanded="True" AutomationProperties.Name="{Binding Name}"
                                                              Loaded="GroupExpander_Loaded" Expanded="GroupExpander_Toggled"
                                                              Collapsed="GroupExpander_Toggled">
                                                        <Expander.Header>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                                               Foreground="{DynamicResource AccentBrush}" />
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat='  ·  {0} sensors'}"
                                                                               Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <!-- reorder controls, shown on hover -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,-4,0,-4">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Opacity" Value="0" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                                    <Setter Property="Opacity" Value="1" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Width="26" Height="26"
                                                                            Click="GroupUp_Click" ToolTip="Move up" AutomationProperties.Name="Move group up" />
                                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Width="26" Height="26"
                                                                            Click="GroupDown_Click" ToolTip="Move down" AutomationProperties.Name="Move group down" />
                                                                    <Border Width="26" Height="26" Background="Transparent" Cursor="SizeAll" Margin="4,0,0,0"
                                                                            ToolTip="Drag to reorder" PreviewMouseLeftButtonDown="Grip_MouseDown" PreviewMouseLeftButtonUp="Grip_MouseUp"
                                                                            MouseMove="Grip_MouseMove">
                                                                        <TextBlock Text="&#xE700;" Style="{StaticResource Icon}" FontSize="13"
                                                                                   HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Expander.Header>
                                                        <ItemsPresenter />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SensorVm}">
                                <Grid Margin="22,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Val" Grid.Column="2" Text="{Binding ValueText}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding MinText}" Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding MaxText}" Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Button Grid.Column="5" Style="{StaticResource IconButton}" AutomationProperties.Name="Add to the selected overlay" Content="&#xE710;" HorizontalAlignment="Right"
                                            Width="26" Height="26" Click="AddSensor_Click" ToolTip="Add to the selected overlay" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="1">
                                        <Setter TargetName="Val" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                        <Setter TargetName="Val" Property="Foreground" Value="{DynamicResource HotBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="EmptyText" Text="No sensors match this filter." Style="{StaticResource Muted}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
