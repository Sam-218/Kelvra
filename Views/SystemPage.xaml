<UserControl x:Class="Kelvra.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kelvra">
    <UserControl.Resources>
        <!-- A value: plain text that can still be selected and copied -->
        <Style x:Key="InfoValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One line of a card: label · value, a sub-heading, or a value with a fill bar -->
        <DataTemplate DataType="{x:Type local:InfoLine}">
            <Grid x:Name="Row" Margin="0,3">
                <Grid.ColumnDefinitions>
                    <!-- Every label column of a card is as wide as its longest label (up to a limit) -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel" MaxWidth="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" ToolTip="{Binding Label}" />
                <TextBox x:Name="Value" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding Value, Mode=OneWay}" />
                <ProgressBar x:Name="Bar" Grid.Row="1" Grid.Column="1" Style="{StaticResource Meter}" Maximum="1"
                             Value="{Binding Fraction, Mode=OneWay}" Margin="0,5,0,3" Visibility="Collapsed" />

                <!-- Sub-heading (one adapter of several): a hairline above, name, and a muted note on the right -->
                <StackPanel x:Name="Heading" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
                    <Rectangle x:Name="HeadingLine" Height="1" Fill="{DynamicResource LineBrush}" Margin="0,4,0,10" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMeter}" Value="True">
                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter TargetName="Heading" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Row" Property="Margin" Value="0,6,0,3" />
                </DataTrigger>
                <!-- The first heading of a card sits right under the card's title: no line, no gap -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsHeading}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="HeadingLine" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Row" Property="Margin" Value="0,0,0,3" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="28,24,16,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,12,16">
            <StackPanel>
                <TextBlock Text="System" Style="{StaticResource H1}" />
                <TextBlock x:Name="Subtitle" Text="A summary of your PC's hardware and Windows." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <TextBlock x:Name="ArrangeHint" Style="{StaticResource Muted}" Margin="0,2,0,0" Visibility="Collapsed"
                           Text="Make the window wider to move and resize the cards." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="TidyButton" Style="{StaticResource GhostButton}" Padding="10,5" Click="Tidy_Click" Margin="0,0,4,0"
                        ToolTip="Close the gaps: every card moves up as far as it fits, keeping its column and size"
                        AutomationProperties.Name="Tidy up" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="Tidy up" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="ResetOrderButton" Style="{StaticResource GhostButton}" Padding="10,5" Click="ResetOrder_Click" Margin="0,0,8,0"
                        ToolTip="Put the cards back where they started, in their original sizes" AutomationProperties.Name="Reset layout" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="Reset layout" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Click="Copy_Click" ToolTip="Copy everything as text, e.g. for a forum post">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Copy summary" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid>
            <!-- Mouse capture sits here while a card is dragged: the cards themselves get moved around underneath -->
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False"
                          MouseMove="Scroller_MouseMove" MouseLeftButtonUp="Scroller_MouseUp" LostMouseCapture="Scroller_LostMouseCapture">
                <ItemsControl x:Name="Sections" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:CardGridPanel PlaceholderInset="0,0,12,12" Loaded="Grid_Loaded" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:InfoSection}">
                            <!-- The 12 px gap to the next card is outside the card; the resize edges reach into it -->
                            <Grid x:Name="CardRoot" Margin="0,0,12,12">
                                <Border Style="{StaticResource Card}" Margin="0" Padding="16,14,12,14">
                                    <DockPanel Grid.IsSharedSizeScope="True">
                                        <!-- The header is the drag handle; the values below stay selectable -->
                                        <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="0,0,0,10" Background="Transparent" Cursor="SizeAll"
                                                   ToolTip="Drag to move this card"
                                                   PreviewMouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove"
                                                   PreviewMouseLeftButtonUp="Header_MouseUp">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Cursor="Hand"
                                                    VerticalAlignment="Top" Content="&#xE712;" Click="CardMenu_Click"
                                                    ToolTip="Size, move or copy this card" AutomationProperties.Name="Card options" />
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}" />
                                                <TextBlock x:Name="CardSubtitle" Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- Scrolls only when the card was made shorter than its content -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" PreviewMouseWheel="CardBody_PreviewMouseWheel">
                                            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- Resize edges, like a window's: right, bottom, and the corner for both -->
                                <Border x:Name="RightGrip" Tag="Right" Width="10" HorizontalAlignment="Right" Margin="0,12,-7,18" Background="Transparent"
                                        Cursor="SizeWE" ToolTip="Drag to make the card wider or narrower · double-click: fill up to the next card"
                                        PreviewMouseLeftButtonDown="Grip_MouseDown">
                                    <Rectangle x:Name="RightLine" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}" Opacity="0" />
                                </Border>
                                <Border x:Name="BottomGrip" Tag="Bottom" Height="10" VerticalAlignment="Bottom" Margin="12,0,18,-7" Background="Transparent"
                                        Cursor="SizeNS" ToolTip="Drag to make the card taller or shorter · double-click: fit to its content"
                                        PreviewMouseLeftButtonDown="Grip_MouseDown">
                                    <Rectangle x:Name="BottomLine" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}" Opacity="0" />
                                </Border>
                                <Border x:Name="CornerGrip" Tag="Corner" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-7,-7" Background="Transparent" Cursor="SizeNWSE" ToolTip="Drag to resize · double-click: fit to the content"
                                        PreviewMouseLeftButtonDown="Grip_MouseDown">
                                    <Path x:Name="CornerMark" Data="M 14,5 L 5,14 M 14,9 L 9,14" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Subtitle}" Value="">
                                    <Setter TargetName="CardSubtitle" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CornerMark" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger SourceName="RightGrip" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RightLine" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger SourceName="BottomGrip" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BottomLine" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger SourceName="CornerGrip" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CornerMark" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <!-- Too narrow a window for the grid: the cards just flow, nothing to drag -->
                                <DataTrigger Binding="{Binding CanArrange, RelativeSource={RelativeSource AncestorType=local:SystemPage}}" Value="False">
                                    <Setter TargetName="RightGrip" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="BottomGrip" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CornerGrip" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Header" Property="Cursor" Value="Arrow" />
                                    <Setter TargetName="Header" Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="LoadingText" Text="Collecting system information…" Style="{StaticResource Muted}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</UserControl>
