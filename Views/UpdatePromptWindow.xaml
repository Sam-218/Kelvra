<Window x:Class="Kelvra.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kelvra" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="26,24,26,22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock x:Name="Heading" Text="A new version of Kelvra is available" Style="{StaticResource H1}" FontSize="19"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="20" />

        <TextBlock Text="What's new" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,10">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" Style="{StaticResource Muted}" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource HotBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="LaterButton" Content="Not now" MinWidth="90" IsCancel="True" Click="Later_Click" />
            <Button x:Name="InstallButton" Content="Install and restart" Style="{StaticResource AccentButton}" MinWidth="150"
                    Margin="8,0,0,0" IsDefault="True" Click="Install_Click" />
        </StackPanel>
    </StackPanel>
</Window>
